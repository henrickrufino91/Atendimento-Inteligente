package br.com.hospital.atendimento.model;
import jakarta.persistence.*; import lombok.*; import java.time.*;
@Entity @Getter @Setter @NoArgsConstructor
public class Triagem {
 @Id @GeneratedValue(strategy=GenerationType.IDENTITY) private Long id;
 @ManyToOne(optional=false) private Paciente paciente;
 @OneToOne private SenhaAtendimento senha;
 @ManyToOne private Profissional profissional;
 private LocalDateTime iniciadaEm=LocalDateTime.now();
 private LocalDateTime concluidaEm;
 @Enumerated(EnumType.STRING) private StatusTriagem status=StatusTriagem.EM_TRIAGEM;
 @Column(length=1200) private String queixaPrincipal;
 private String inicioSintomas;
 @Column(length=1200) private String alergias;
 @Column(length=1200) private String medicamentosEmUso;
 @Column(length=1200) private String condicoesClinicas;
 @Column(length=2000) private String observacoes;
}
