package br.com.hospital.atendimento.model;

import java.time.LocalDateTime;

import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import jakarta.persistence.ManyToOne;
import lombok.Getter;
import lombok.NoArgsConstructor;
import lombok.Setter;

@Entity
@Getter
@Setter
@NoArgsConstructor
public class SinalVital {
	@Id
	@GeneratedValue(strategy = GenerationType.IDENTITY)
	private Long id;
	@ManyToOne(optional = false)
	private Triagem triagem;
	private LocalDateTime registradoEm = LocalDateTime.now();
	private Integer pressaoSistolica, pressaoDiastolica, frequenciaCardiaca, frequenciaRespiratoria, saturacao,
			glicemia, dor;
	private Double temperatura, peso, altura;
}
