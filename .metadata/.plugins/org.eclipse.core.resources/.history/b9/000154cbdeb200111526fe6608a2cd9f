package br.com.hospital.atendimento.model;
import jakarta.persistence.*; import lombok.*; import java.time.*;
@Entity @Getter @Setter @NoArgsConstructor
public class Exame {
 @Id @GeneratedValue(strategy=GenerationType.IDENTITY) private Long id;
 @ManyToOne(optional=false) private Paciente paciente;
 private String tipo; private LocalDateTime solicitadoEm=LocalDateTime.now();
 private String status="SOLICITADO"; @Column(length=3000) private String resultado;
}
