package br.com.hospital.atendimento.controller;
import br.com.hospital.atendimento.repository.*; import org.springframework.stereotype.Controller; import org.springframework.ui.Model; import org.springframework.web.bind.annotation.*;
@Controller @RequestMapping("/auditoria") public class AuditoriaController {
 private final AuditoriaUsuarioRepository audit; private final HistoricoLoginRepository logins;
 public AuditoriaController(AuditoriaUsuarioRepository a,HistoricoLoginRepository l){audit=a;logins=l;}
 @GetMapping public String tela(Model m){m.addAttribute("auditorias",audit.findAll());m.addAttribute("logins",logins.findAll());return "auditoria/lista";}
}
