<!DOCTYPE html>
<html lang="pt-br" xmlns:th="http://www.thymeleaf.org"
	xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Fila de senhas</title>
<link rel="stylesheet" th:href="@{/css/app.css}">
</head>
<body>
	<nav th:replace="~{fragments :: nav}"></nav>
	<main class="container">
		<div class="page-head">
			<div>
				<h1>Fila de senhas</h1>
				<p>Controle de triagem, risco, chamada e atendimento do dia</p>
			</div>
			<a sec:authorize="hasAuthority('FILA_EMITIR')" class="primary btn"
				th:href="@{/fila-senhas/nova}">Emitir nova senha</a>
		</div>
		<div th:if="${sucesso}" class="alert success" th:text="${sucesso}"></div>
		<div th:if="${erro}" class="alert error" th:text="${erro}"></div>
		<section class="cards queue-cards">
			<div class="card">
				<span>Aguardando</span><strong th:text="${aguardando}">0</strong>
			</div>
			<div class="card">
				<span>Emitidas hoje</span><strong th:text="${#lists.size(senhas)}">0</strong>
			</div>
		</section>
		<div class="note">
			<strong>Ordem automática:</strong> primeiro nível de risco
			confirmado, depois preferência da senha e, por fim, horário de
			emissão.
		</div>
		<section class="panel">
			<div class="queue-actions">
				<form sec:authorize="hasAuthority('FILA_CHAMAR')"
					th:action="@{/fila-senhas/chamar-proxima}" method="post">
					<input name="guiche" value="GUICHÊ 1" placeholder="Guichê">
					<button class="primary">Chamar próxima</button>
				</form>
			</div>
			<table>
				<thead>
					<tr>
						<th>Senha</th>
						<th>Tipo</th>
						<th>Paciente</th>
						<th>Risco</th>
						<th>Emissão</th>
						<th>Status</th>
						<th>Guichê</th>
						<th>Ações</th>
					</tr>
				</thead>
				<tbody>
					<tr th:each="s:${senhas}">
						<td><strong class="ticket" th:text="${s.codigo}">N001</strong></td>
						<td th:text="${s.tipo}"></td>
						<td
							th:text="${s.paciente != null ? s.paciente.nome : 'Não identificado'}"></td>
						<td><span th:if="${s.nivelRisco != null}" class="risk-badge"
							th:classappend="${' risk-' + #strings.toLowerCase(s.nivelRisco.name())}"
							th:text="${s.nivelRisco}"></span><span
							th:if="${s.nivelRisco == null}" class="muted">Não
								classificado</span></td>
						<td th:text="${#temporals.format(s.emitidaEm,'HH:mm')}"></td>
						<td><span class="badge"
							th:classappend="${s.tipo.name() == 'PRIORITARIA'} ? ' priority'"
							th:text="${s.status}"></span></td>
						<td th:text="${s.guiche != null ? s.guiche : '-'}"></td>
						<td class="row-actions"><a
							sec:authorize="hasAuthority('RISCO_CLASSIFICAR')"
							th:if="${s.status.name() == 'AGUARDANDO'}" class="btn secondary"
							th:href="@{'/classificacao-risco/senha/'+${s.id}}"
							th:text="${s.nivelRisco == null ? 'Classificar risco' : 'Reclassificar'}"></a>
						<form sec:authorize="hasAuthority('FILA_CHAMAR')"
								th:if="${s.status.name() == 'AGUARDANDO' and s.nivelRisco != null}"
								th:action="@{'/fila-senhas/'+${s.id}+'/chamar'}" method="post">
								<input type="hidden" name="guiche" value="GUICHÊ 1">
								<button class="btn secondary">Chamar</button>
							</form>
							<a sec:authorize="hasAuthority('FILA_CHAMAR')"
							th:if="${s.status.name() == 'CHAMADA'}" class="btn primary"
							th:href="@{'/fila-senhas/'+${s.id}+'/iniciar'}">Iniciar
								atendimento</a><a th:if="${s.atendimento != null}"
							class="btn secondary"
							th:href="@{'/atendimentos/'+${s.atendimento.id}}">Ver
								atendimento</a>
						<form sec:authorize="hasAuthority('FILA_CHAMAR')"
								th:if="${s.status.name() == 'EM_ATENDIMENTO'}"
								th:action="@{'/fila-senhas/'+${s.id}+'/finalizar'}"
								method="post">
								<button class="btn secondary">Finalizar fila</button>
							</form>
							<form sec:authorize="hasAuthority('FILA_CHAMAR')"
								th:if="${s.status.name() == 'AGUARDANDO' or s.status.name() == 'CHAMADA'}"
								th:action="@{'/fila-senhas/'+${s.id}+'/cancelar'}" method="post">
								<button class="btn danger">Cancelar</button>
							</form></td>
					</tr>
					<tr th:if="${#lists.isEmpty(senhas)}">
						<td colspan="8">Nenhuma senha emitida hoje.</td>
					</tr>
				</tbody>
			</table>
		</section>
	</main>
</body>
</html>
