<!doctype html><html lang="pt-BR" xmlns:th="http://www.thymeleaf.org"><head><meta charset="utf-8"><title>Usuários</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/app.css"></head><body><nav class="navbar navbar-dark bg-dark navbar-expand-xl mb-4"><div class="container-fluid"><a class="navbar-brand" href="/">Atendimento Inteligente v3</a><div class="navbar-nav flex-wrap"><a class="nav-link" href="/">Dashboard</a><a class="nav-link" href="/pacientes">Pacientes</a><a class="nav-link" href="/fila-senhas">Fila</a><a class="nav-link" href="/triagens">Triagem</a><a class="nav-link" href="/atendimentos">Atendimento</a><a class="nav-link" href="/relatorios">Relatórios</a><a class="nav-link" href="/usuarios">Usuários</a><a class="nav-link" href="/perfis">Perfis</a><form method="post" action="/logout"><button class="btn btn-sm btn-outline-light mt-1">Sair</button></form></div></div></nav><main class="container">
<div class="d-flex justify-content-between"><h2>Usuários</h2><a class="btn btn-primary" href="/usuarios/novo">Novo usuário</a></div>
<table class="table table-striped"><thead><tr><th>Nome</th><th>E-mail</th><th>Perfis</th><th>Status</th><th>Ações</th></tr></thead><tbody><tr th:each="u:${itens}"><td th:text="${u.nome}"></td><td th:text="${u.email}"></td><td><span th:each="p:${u.perfis}" class="badge bg-secondary me-1" th:text="${p.nome}"></span></td><td th:text="${u.ativo?'Ativo':'Inativo'}"></td><td><a class="btn btn-sm btn-outline-primary" th:href="@{/usuarios/{id}/editar(id=${u.id})}">Editar</a> <form class="d-inline" method="post" th:action="@{/usuarios/{id}/status(id=${u.id})}"><button class="btn btn-sm btn-outline-warning">Ativar/Desativar</button></form></td></tr></tbody></table>
</main></body></html>
