<!DOCTYPE html><html lang="pt-br" xmlns:th="http://www.thymeleaf.org"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Novo atendimento</title><link rel="stylesheet" th:href="@{/css/app.css}"></head><body><nav th:replace="~{fragments :: nav}"></nav><main class="container narrow"><h1>Novo atendimento</h1><div class="note">A classificação inteligente é um apoio operacional e não substitui avaliação clínica.</div><form class="panel form-grid" th:action="@{/atendimentos/salvar}" method="post"><input type="hidden" name="agendamentoId" th:value="${agendamentoId}"><input type="hidden" name="senhaId" th:value="${senhaId}"><label class="span2">Paciente<select id="pacienteId" name="pacienteId" required onchange="filtrarConvenios()"><option th:each="p:${pacientes}" th:value="${p.id}" th:text="${p.nome}" th:selected="${pacienteId != null and p.id == pacienteId}"></option></select></label><label class="span2">Profissional<select name="profissionalId" required><option th:each="p:${profissionais}" th:value="${p.id}" th:text="${p.nome+' - '+p.especialidade}"></option></select></label><label>Forma de atendimento<select id="tipoPagamento" name="tipoPagamento" onchange="toggleConvenio()"><option value="PARTICULAR" th:selected="${tipoPagamentoSelecionado == null or tipoPagamentoSelecionado.name() == 'PARTICULAR'}">Particular</option><option value="CONVENIO" th:selected="${tipoPagamentoSelecionado != null and tipoPagamentoSelecionado.name() == 'CONVENIO'}">Convênio</option></select></label><label id="boxConvenio">Convênio / plano<select id="pacienteConvenioId" name="pacienteConvenioId"><option value="">Selecione...</option><option th:each="v:${vinculosConvenio}" th:value="${v.id}" th:attr="data-paciente=${v.paciente.id}" th:selected="${pacienteConvenioSelecionado != null and v.id == pacienteConvenioSelecionado}" th:text="${v.convenio.nome+' • '+v.plano+' • '+v.numeroCarteirinha}"></option></select></label><label class="span2">Queixa principal<textarea name="queixaPrincipal" required placeholder="Descreva sintomas e motivo do atendimento"></textarea></label><label class="span2">Anamnese inicial<textarea name="anamnese"></textarea></label><label>Pressão arterial<input name="pressaoArterial" placeholder="120/80"></label><label>Temperatura °C<input type="number" step="0.1" name="temperatura"></label><label>Frequência cardíaca<input type="number" name="frequenciaCardiaca"></label><label>Saturação %<input type="number" step="0.1" name="saturacao"></label><div class="span2 actions"><a class="btn secondary" th:href="@{/atendimentos}">Cancelar</a><button class="primary">Abrir atendimento</button></div></form></main><script>function toggleConvenio(){document.getElementById('boxConvenio').style.display=document.getElementById('tipoPagamento').value==='CONVENIO'?'block':'none'}function filtrarConvenios(){const p=document.getElementById('pacienteId').value;document.querySelectorAll('#pacienteConvenioId option[data-paciente]').forEach(o=>o.hidden=o.dataset.paciente!==p)}document.addEventListener('DOMContentLoaded',()=>{filtrarConvenios();toggleConvenio()});</script></body></html>
