<!DOCTYPE html><html lang="pt-br" xmlns:th="http://www.thymeleaf.org"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Pacientes</title><link rel="stylesheet" th:href="@{/css/app.css}"></head><body><nav th:replace="~{fragments :: nav}"></nav><main class="container"><div class="page-head"><div><h1>Pacientes</h1><p>Cadastro e consulta de pacientes</p></div><a class="primary btn" th:href="@{/pacientes/novo}">Novo paciente</a></div><div class="alert success" th:if="${sucesso}" th:text="${sucesso}"></div><form class="search" method="get"><input name="busca" th:value="${busca}" placeholder="Buscar por nome"><button>Buscar</button></form><section class="panel"><table><thead><tr><th>Nome</th><th>CPF</th><th>Nascimento</th><th>Telefone</th><th></th></tr></thead><tbody><tr th:each="p:${pacientes}"><td th:text="${p.nome}"></td><td th:text="${p.cpf}"></td><td th:text="${#temporals.format(p.dataNascimento,'dd/MM/yyyy')}"></td><td th:text="${p.telefone}"></td><td><a th:href="@{/pacientes/{id}/editar(id=${p.id})}">Editar</a></td></tr></tbody></table></section></main></body></html>