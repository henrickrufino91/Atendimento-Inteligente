<!doctype html><html lang="pt-BR" xmlns:th="http://www.thymeleaf.org"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Nova triagem</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/app.css"></head><body><nav class="navbar navbar-dark bg-dark navbar-expand-xl mb-4"><div class="container-fluid"><a class="navbar-brand" href="/">Atendimento Inteligente v2</a><div class="navbar-nav flex-wrap"><a class="nav-link" href="/">Dashboard</a><a class="nav-link" href="/pacientes">Pacientes</a><a class="nav-link" href="/profissionais">Profissionais</a><a class="nav-link" href="/agendamentos">Agendamentos</a><a class="nav-link" href="/fila-senhas">Fila</a><a class="nav-link" href="/triagens">Triagem</a><a class="nav-link" href="/atendimentos">Atendimento</a><a class="nav-link" href="/prescricoes">Prescrições</a><a class="nav-link" href="/exames">Exames</a><a class="nav-link" href="/relatorios">Relatórios</a><form method="post" action="/logout"><button class="btn btn-sm btn-outline-light mt-1">Sair</button></form></div></div></nav><main class="container">
<h2>Nova triagem</h2><form method="post" action="/triagens/salvar" th:object="${item}">
<input type="hidden" th:field="*{id}"><input type="hidden" th:field="*{senha.id}">
<label>Paciente</label><select class="form-select mb-2" th:field="*{paciente.id}" required><option th:each="p:${pacientes}" th:value="${p.id}" th:text="${p.nome}"></option></select>
<label>Profissional</label><select class="form-select mb-2" th:field="*{profissional.id}"><option value="">--</option><option th:each="p:${profissionais}" th:value="${p.id}" th:text="${p.nome}"></option></select>
<label>Queixa principal</label><textarea class="form-control mb-2" th:field="*{queixaPrincipal}" required></textarea>
<div class="row"><div class="col"><label>Início/duração dos sintomas</label><input class="form-control mb-2" th:field="*{inicioSintomas}"></div><div class="col"><label>Dor 0-10</label><input type="number" min="0" max="10" class="form-control" name="dor"></div></div>
<h5 class="mt-3">Sinais vitais</h5><div class="row g-2">
<div class="col-md-2"><input class="form-control" type="number" name="pressaoSistolica" placeholder="PA sistólica"></div><div class="col-md-2"><input class="form-control" type="number" name="pressaoDiastolica" placeholder="PA diastólica"></div>
<div class="col-md-2"><input class="form-control" type="number" step=".1" name="temperatura" placeholder="Temp °C"></div><div class="col-md-2"><input class="form-control" type="number" name="frequenciaCardiaca" placeholder="FC"></div>
<div class="col-md-2"><input class="form-control" type="number" name="frequenciaRespiratoria" placeholder="FR"></div><div class="col-md-2"><input class="form-control" type="number" name="saturacao" placeholder="SpO₂ %"></div>
<div class="col-md-2"><input class="form-control" type="number" name="glicemia" placeholder="Glicemia"></div><div class="col-md-2"><input class="form-control" type="number" step=".1" name="peso" placeholder="Peso kg"></div><div class="col-md-2"><input class="form-control" type="number" step=".01" name="altura" placeholder="Altura m"></div></div>
<label class="mt-3">Alergias</label><textarea class="form-control" th:field="*{alergias}"></textarea><label>Medicamentos em uso</label><textarea class="form-control" th:field="*{medicamentosEmUso}"></textarea>
<label>Condições clínicas</label><textarea class="form-control" th:field="*{condicoesClinicas}"></textarea><label>Observações</label><textarea class="form-control mb-3" th:field="*{observacoes}"></textarea>
<button class="btn btn-success">Concluir triagem</button></form>
</main></body></html>
