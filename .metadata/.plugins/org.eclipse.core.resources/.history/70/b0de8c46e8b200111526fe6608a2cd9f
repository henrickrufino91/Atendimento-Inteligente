<!doctype html><html lang="pt-BR" xmlns:th="http://www.thymeleaf.org"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Triagem</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/app.css"></head><body><nav class="navbar navbar-dark bg-dark navbar-expand-xl mb-4"><div class="container-fluid"><a class="navbar-brand" href="/">Atendimento Inteligente v2</a><div class="navbar-nav flex-wrap"><a class="nav-link" href="/">Dashboard</a><a class="nav-link" href="/pacientes">Pacientes</a><a class="nav-link" href="/profissionais">Profissionais</a><a class="nav-link" href="/agendamentos">Agendamentos</a><a class="nav-link" href="/fila-senhas">Fila</a><a class="nav-link" href="/triagens">Triagem</a><a class="nav-link" href="/atendimentos">Atendimento</a><a class="nav-link" href="/prescricoes">Prescrições</a><a class="nav-link" href="/exames">Exames</a><a class="nav-link" href="/relatorios">Relatórios</a><form method="post" action="/logout"><button class="btn btn-sm btn-outline-light mt-1">Sair</button></form></div></div></nav><main class="container">
<h2>Triagem</h2><div class="card p-3 mb-3"><b th:text="${item.paciente.nome}"></b><p th:text="${item.queixaPrincipal}"></p><p><strong>Alergias:</strong> <span th:text="${item.alergias}"></span></p><p><strong>Medicamentos:</strong> <span th:text="${item.medicamentosEmUso}"></span></p></div>
<h4>Sinais vitais</h4><table class="table"><thead><tr><th>PA</th><th>Temp.</th><th>FC</th><th>FR</th><th>SpO₂</th><th>Glicemia</th><th>Dor</th></tr></thead><tbody><tr th:each="v:${sinais}"><td th:text="${v.pressaoSistolica+' / '+v.pressaoDiastolica}"></td><td th:text="${v.temperatura}"></td><td th:text="${v.frequenciaCardiaca}"></td><td th:text="${v.frequenciaRespiratoria}"></td><td th:text="${v.saturacao}"></td><td th:text="${v.glicemia}"></td><td th:text="${v.dor}"></td></tr></tbody></table>
</main></body></html>
