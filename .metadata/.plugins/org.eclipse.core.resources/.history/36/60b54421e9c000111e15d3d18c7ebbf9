<!DOCTYPE html><html lang="pt-br" xmlns:th="http://www.thymeleaf.org"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Atendimentos</title><link rel="stylesheet" th:href="@{/css/app.css}"></head><body><nav th:replace="~{fragments :: nav}"></nav><main class="container"><div class="page-head"><div><h1>Atendimentos</h1><p>Histórico clínico recente</p></div><a class="primary btn" th:href="@{/atendimentos/novo}">Novo atendimento</a></div><div class="alert success" th:if="${sucesso}" th:text="${sucesso}"></div><section class="panel"><table><thead><tr><th>Início</th><th>Paciente</th><th>Profissional</th><th>Classificação</th><th>Situação</th><th></th></tr></thead><tbody><tr th:each="a:${atendimentos}"><td th:text="${#temporals.format(a.inicio,'dd/MM/yyyy HH:mm')}"></td><td th:text="${a.paciente.nome}"></td><td th:text="${a.profissional.nome}"></td><td><span class="badge" th:text="${a.classificacao}"></span></td><td th:text="${a.fim==null?'EM ABERTO':'FINALIZADO'}"></td><td><a th:href="@{/atendimentos/{id}(id=${a.id})}">Abrir</a></td></tr></tbody></table></section></main></body></html>