<!DOCTYPE html><html lang="pt-br" xmlns:th="http://www.thymeleaf.org" xmlns:sec="http://www.thymeleaf.org/extras/spring-security"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Relatórios e indicadores</title><link rel="stylesheet" th:href="@{/css/app.css}"></head><body>
<nav th:replace="~{fragments :: nav}"></nav><main class="container">
<div class="page-head"><div><h1>Relatórios e indicadores</h1><p>Visão analítica do período selecionado</p></div><a sec:authorize="hasAuthority('PAINEL_GERENCIAL_VISUALIZAR')" class="btn primary" th:href="@{/relatorios/tempo-real}">Abrir painel em tempo real</a></div>
<section class="panel"><form method="get" class="report-filter"><label>Data inicial<input type="date" name="inicio" th:value="${inicio}"></label><label>Data final<input type="date" name="fim" th:value="${fim}"></label><button class="primary" type="submit">Aplicar filtros</button><a class="btn secondary" th:href="@{/relatorios}">Últimos 30 dias</a></form>
<div class="report-export"><div sec:authorize="hasAuthority('RELATORIO_EXPORTAR')"><a class="btn secondary" th:href="@{/relatorios/exportar/senhas(inicio=${inicio},fim=${fim})}">Fila CSV</a> <a class="btn secondary" th:href="@{/relatorios/exportar/atendimentos(inicio=${inicio},fim=${fim})}">Atendimentos CSV</a></div><form sec:authorize="hasAuthority('RELATORIO_PDF_GERAR')" class="pdf-form" th:action="@{/relatorios/pdf/mensal}" method="get"><input type="month" name="mes" th:value="${mesPdf}"><button class="btn secondary" type="submit">Gerar PDF mensal</button></form></div></section>
<section class="cards report-cards"><div class="card"><span>Senhas emitidas</span><strong th:text="${r.senhasEmitidas}">0</strong></div><div class="card"><span>Senhas finalizadas</span><strong th:text="${r.senhasFinalizadas}">0</strong></div><div class="card"><span>Aguardando</span><strong th:text="${r.aguardando}">0</strong></div><div class="card"><span>Canceladas</span><strong th:text="${r.senhasCanceladas}">0</strong></div><div class="card"><span>Atendimentos</span><strong th:text="${r.atendimentos}">0</strong></div><div class="card"><span>Finalização da fila</span><strong th:text="${#numbers.formatDecimal(r.percentualFinalizacao,1,1)} + '%'">0%</strong></div><div class="card"><span>Espera média</span><strong th:text="${#numbers.formatDecimal(r.tempoMedioEsperaMin,1,1)} + ' min'">0 min</strong></div><div class="card"><span>Atendimento médio</span><strong th:text="${#numbers.formatDecimal(r.tempoMedioAtendimentoMin,1,1)} + ' min'">0 min</strong></div><div class="card"><span>SLA classificação</span><strong th:text="${#numbers.formatDecimal(r.percentualSlaRisco,1,1)} + '%'">0%</strong></div></section>
<section class="grid2 analytics-grid"><div class="panel chart-panel"><div class="chart-title"><div><h2>Fluxo no período</h2><p>Senhas emitidas x atendimentos</p></div><span class="legend"><i class="dot dot-a"></i>Senhas <i class="dot dot-b"></i>Atendimentos</span></div><canvas id="chartVolume" class="report-canvas"></canvas></div><div class="panel chart-panel"><div class="chart-title"><div><h2>Distribuição por risco</h2><p>Composição das classificações</p></div></div><canvas id="chartRisco" class="report-canvas"></canvas></div></section>
<section class="panel chart-panel"><div class="chart-title"><div><h2>Produtividade por profissional</h2><p>Atendimentos registrados no período</p></div></div><canvas id="chartProfissionais" class="report-canvas wide"></canvas></section>
<section class="grid2"><div class="panel"><h2>Classificação de risco</h2><table class="compact"><thead><tr><th>Nível</th><th>Qtd.</th><th>No alvo</th><th>SLA</th></tr></thead><tbody><tr th:each="i:${r.riscos}"><td><span class="risk-badge" th:classappend="${' risk-' + #strings.toLowerCase(i.nivel.name())}" th:text="${i.nivel.name()}"></span></td><td th:text="${i.quantidade}"></td><td th:text="${i.dentroDoAlvo}"></td><td th:text="${#numbers.formatDecimal(i.percentualDentroDoAlvo,1,1)} + '%'"></td></tr></tbody></table></div><div class="panel"><h2>Ranking de produtividade</h2><table class="compact"><thead><tr><th>Profissional</th><th>Atendimentos</th><th>Finalizados</th></tr></thead><tbody><tr th:each="p:${r.profissionais}"><td th:text="${p.profissional}"></td><td th:text="${p.atendimentos}"></td><td th:text="${p.finalizados}"></td></tr><tr th:if="${#lists.isEmpty(r.profissionais)}"><td colspan="3">Sem dados no período.</td></tr></tbody></table></div></section>
</main><script th:src="@{/js/report-charts.js}"></script><script th:src="@{/js/relatorios-dashboard.js}"></script></body></html>
