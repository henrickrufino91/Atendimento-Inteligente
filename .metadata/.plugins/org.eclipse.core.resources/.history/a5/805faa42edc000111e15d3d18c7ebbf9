<!DOCTYPE html><html lang="pt-br" xmlns:th="http://www.thymeleaf.org"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Convênio</title><link rel="stylesheet" th:href="@{/css/app.css}"></head><body><nav th:replace="~{fragments :: nav}"></nav><main class="container narrow"><h1 th:text="${convenio==null?'Novo convênio':'Editar convênio'}"></h1><form class="panel form-grid" th:action="@{/convenios/salvar}" method="post"><input type="hidden" name="id" th:value="${convenio?.id}"><label class="span2">Nome da operadora<input name="nome" required th:value="${convenio?.nome}"></label><label>Registro ANS<input name="registroAns" th:value="${convenio?.registroAns}"></label><label>Telefone<input name="telefone" th:value="${convenio?.telefone}"></label><label class="span2">E-mail<input type="email" name="email" th:value="${convenio?.email}"></label><label class="checkline"><input type="checkbox" name="ativo" value="true" th:checked="${convenio==null or convenio.ativo}"> Convênio ativo</label><div class="span2 actions"><a class="btn secondary" th:href="@{/convenios}">Cancelar</a><button class="primary">Salvar</button></div></form></main></body></html>
