<!DOCTYPE html>
<html lang="pt-br" xmlns:th="http://www.thymeleaf.org">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Login</title>
<link rel="stylesheet" th:href="@{/css/app.css}">
</head>
<body class="login-body">
	<main class="login-card">
		<h1>Hospital Smart</h1>
		<p>Atendimento inteligente ao paciente</p>
		<div class="alert error" th:if="${param.error}">E-mail ou senha
			inválidos.</div>
		<div class="alert success" th:if="${param.logout}">Sessão
			encerrada.</div>
		<form th:action="@{/login}" method="post">
			<label>E-mail<input type="email" name="username"
				value="admin@hospital.local" required></label><label>Senha<input
				type="password" name="password" value="Admin@123" required></label>
			<button class="primary">Entrar</button>
		</form>
		<small>Demo: admin@hospital.local / Admin@123</small>
	</main>
</body>
</html>