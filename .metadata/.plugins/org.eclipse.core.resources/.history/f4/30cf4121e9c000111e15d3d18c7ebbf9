<!DOCTYPE html><html lang="pt-br" xmlns:th="http://www.thymeleaf.org"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Novo agendamento</title><link rel="stylesheet" th:href="@{/css/app.css}"></head><body><nav th:replace="~{fragments :: nav}"></nav><main class="container narrow"><h1>Novo agendamento</h1><form class="panel form-grid" th:action="@{/agendamentos/salvar}" method="post"><label class="span2">Paciente<select name="pacienteId" required><option th:each="p:${pacientes}" th:value="${p.id}" th:text="${p.nome}"></option></select></label><label class="span2">Profissional<select name="profissionalId" required><option th:each="p:${profissionais}" th:value="${p.id}" th:text="${p.nome+' - '+p.especialidade}"></option></select></label><label>Data e hora<input type="datetime-local" name="dataHora" required></label><label>Tipo<input name="tipo" placeholder="Consulta, retorno..." required></label><label>Prioridade<select name="prioridade"><option th:each="p:${prioridades}" th:value="${p}" th:text="${p}"></option></select></label><label class="span2">Observações<textarea name="observacoes"></textarea></label><div class="span2 actions"><a class="btn secondary" th:href="@{/agendamentos}">Cancelar</a><button class="primary">Salvar</button></div></form></main></body></html>