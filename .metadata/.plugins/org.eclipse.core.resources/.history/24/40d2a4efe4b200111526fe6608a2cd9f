<!doctype html><html lang="pt-BR" xmlns:th="http://www.thymeleaf.org"><head><meta charset="utf-8"><title>Usuário</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/app.css"></head><body><nav class="navbar navbar-dark bg-dark navbar-expand-xl mb-4"><div class="container-fluid"><a class="navbar-brand" href="/">Atendimento Inteligente v3</a><div class="navbar-nav flex-wrap"><a class="nav-link" href="/">Dashboard</a><a class="nav-link" href="/pacientes">Pacientes</a><a class="nav-link" href="/fila-senhas">Fila</a><a class="nav-link" href="/triagens">Triagem</a><a class="nav-link" href="/atendimentos">Atendimento</a><a class="nav-link" href="/relatorios">Relatórios</a><a class="nav-link" href="/usuarios">Usuários</a><a class="nav-link" href="/perfis">Perfis</a><form method="post" action="/logout"><button class="btn btn-sm btn-outline-light mt-1">Sair</button></form></div></div></nav><main class="container">
<h2>Usuário</h2><form method="post" action="/usuarios/salvar" th:object="${item}"><input type="hidden" th:field="*{id}"><input type="hidden" th:field="*{senha}">
<label>Nome</label><input class="form-control mb-2" th:field="*{nome}" required><label>E-mail</label><input type="email" class="form-control mb-2" th:field="*{email}" required>
<label>Nova senha</label><input type="password" class="form-control mb-2" name="novaSenha"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" th:field="*{ativo}"><label>Ativo</label></div>
<label>Perfis</label><select class="form-select mb-3" multiple th:field="*{perfis}"><option th:each="p:${perfis}" th:value="${p.id}" th:text="${p.nome}"></option></select><button class="btn btn-success">Salvar</button></form>
</main></body></html>
