package br.com.hospital.dto;

import jakarta.validation.constraints.*;
import lombok.*;
import java.util.*;

@Getter @Setter @NoArgsConstructor @AllArgsConstructor @Builder
public class PerfilForm {
    private Long id;
    @NotBlank @Pattern(regexp="[A-Z0-9_]+", message="Use apenas letras maiúsculas, números e underscore") @Size(max=50)
    private String codigo;
    @NotBlank @Size(max=100) private String nome;
    @Size(max=255) private String descricao;
    @Builder.Default private List<Long> permissaoIds = new ArrayList<>();
}
