<!DOCTYPE html><html lang="pt-br" xmlns:th="http://www.thymeleaf.org"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Novo agendamento</title><link rel="stylesheet" th:href="@{/css/app.css}"></head><body><nav th:replace="~{fragments :: nav}"></nav><main class="container narrow"><h1>Novo agendamento</h1><form class="panel form-grid" th:action="@{/agendamentos/salvar}" method="post"><label class="span2">Paciente<select id="pacienteId" name="pacienteId" required onchange="filtrarConvenios()"><option th:each="p:${pacientes}" th:value="${p.id}" th:text="${p.nome}"></option></select></label><label class="span2">Profissional<select name="profissionalId" required><option th:each="p:${profissionais}" th:value="${p.id}" th:text="${p.nome+' - '+p.especialidade}"></option></select></label><label>Data e hora<input type="datetime-local" name="dataHora" required></label><label>Tipo<input name="tipo" placeholder="Consulta, retorno..." required></label><label>Prioridade<select name="prioridade"><option th:each="p:${prioridades}" th:value="${p}" th:text="${p}"></option></select></label><label>Forma de atendimento<select id="tipoPagamento" name="tipoPagamento" onchange="toggleConvenio()"><option value="PARTICULAR">Particular</option><option value="CONVENIO">Convênio</option></select></label><label id="boxConvenio" class="span2" style="display:none">Convênio / plano<select id="pacienteConvenioId" name="pacienteConvenioId"><option value="">Selecione...</option><option th:each="v:${vinculosConvenio}" th:value="${v.id}" th:attr="data-paciente=${v.paciente.id}" th:text="${v.convenio.nome+' • '+v.plano+' • '+v.numeroCarteirinha}"></option></select><small>Cadastre o convênio no paciente antes do agendamento.</small></label><label class="span2">Observações<textarea name="observacoes"></textarea></label><div class="span2 actions"><a class="btn secondary" th:href="@{/agendamentos}">Cancelar</a><button class="primary">Salvar</button></div></form></main><script>function toggleConvenio(){document.getElementById('boxConvenio').style.display=document.getElementById('tipoPagamento').value==='CONVENIO'?'block':'none'}function filtrarConvenios(){const p=document.getElementById('pacienteId').value;document.querySelectorAll('#pacienteConvenioId option[data-paciente]').forEach(o=>o.hidden=o.dataset.paciente!==p);document.getElementById('pacienteConvenioId').value=''}document.addEventListener('DOMContentLoaded',()=>{filtrarConvenios();toggleConvenio()});</script></body></html>
