package br.com.hospital.atendimento.controller;
import br.com.hospital.atendimento.model.*; import br.com.hospital.atendimento.repository.*;
import org.springframework.stereotype.Controller; import org.springframework.ui.Model; import org.springframework.web.bind.annotation.*;
@Controller @RequestMapping("/exames")
public class ExameController {
 private final ExameRepository repo; private final PacienteRepository pacientes; private final ProfissionalRepository profissionais;
 public ExameController(ExameRepository r,PacienteRepository p,ProfissionalRepository pr){repo=r;pacientes=p;profissionais=pr;}
 @GetMapping public String lista(Model m){m.addAttribute("itens",repo.findAll());return "exames/lista";}
 @GetMapping("/novo") public String novo(Model m){m.addAttribute("item",new Exame());m.addAttribute("pacientes",pacientes.findAll());m.addAttribute("profissionais",profissionais.findAll());return "exames/form";}
 @PostMapping("/salvar") public String salvar(@ModelAttribute Exame x){repo.save(x);return "redirect:/exames";}
 @PostMapping("/{id}/excluir") public String excluir(@PathVariable Long id){repo.deleteById(id);return "redirect:/exames";}
}
