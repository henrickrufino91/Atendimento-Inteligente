*{box-sizing:border-box}body{margin:0;background:#f4f7fb;color:#1d2939;font-family:Inter,Segoe UI,Arial,sans-serif}.topbar{height:64px;background:#fff;border-bottom:1px solid #e5e7eb;display:flex;align-items:center;justify-content:space-between;padding:0 4%;position:sticky;top:0}.brand{font-size:20px;font-weight:800;color:#0f766e;text-decoration:none}.links{display:flex;gap:22px;align-items:center}.links a,.linkbtn{color:#344054;text-decoration:none;background:none;border:0;font:inherit;cursor:pointer}.container{max-width:1180px;margin:32px auto;padding:0 20px}.narrow{max-width:850px}.page-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}.page-head h1,h1{margin:0 0 6px}.page-head p{margin:0;color:#667085}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:22px}.card,.panel{background:#fff;border:1px solid #eaecf0;border-radius:14px;box-shadow:0 2px 10px #1018280a}.card{padding:20px}.card span{display:block;color:#667085;font-size:14px}.card strong{font-size:30px;display:block;margin-top:8px}.panel{padding:22px;margin-bottom:20px;overflow:auto}.panel h2{margin-top:0;font-size:18px}table{width:100%;border-collapse:collapse;min-width:720px}th,td{text-align:left;padding:13px;border-bottom:1px solid #eaecf0;font-size:14px}th{color:#667085}.primary,.btn,button{border:0;border-radius:8px;padding:10px 16px;font-weight:700;cursor:pointer;text-decoration:none}.primary{background:#0f766e;color:#fff}.secondary{background:#eef2f6;color:#344054}.badge{display:inline-block;background:#ecfdf3;color:#067647;border-radius:999px;padding:5px 9px;font-size:12px;font-weight:700}.badge.big{font-size:14px;padding:8px 14px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.span2{grid-column:span 2}label{display:flex;flex-direction:column;gap:6px;font-size:14px;font-weight:600;margin-bottom:12px}input,select,textarea{width:100%;padding:11px 12px;border:1px solid #d0d5dd;border-radius:8px;background:#fff;font:inherit}textarea{min-height:90px;resize:vertical}.actions{display:flex;justify-content:flex-end;gap:10px}.search{display:flex;gap:8px;margin-bottom:16px}.search input{max-width:360px}.alert,.note{padding:12px 14px;border-radius:8px;margin-bottom:16px}.success{background:#ecfdf3;color:#067647}.error{background:#fef3f2;color:#b42318}.note{background:#eff8ff;color:#175cd3}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:18px}.item{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #eaecf0}.login-body{min-height:100vh;display:grid;place-items:center;background:linear-gradient(145deg,#0f766e,#164e63)}.login-card{width:min(420px,92vw);background:#fff;border-radius:18px;padding:32px;box-shadow:0 20px 60px #0003}.login-card h1{color:#0f766e}.login-card p{color:#667085;margin-bottom:24px}.login-card button{width:100%;margin:8px 0 14px}.login-card small{color:#667085}@media(max-width:800px){.cards,.grid2{grid-template-columns:1fr 1fr}.links a{display:none}.form-grid{grid-template-columns:1fr}.span2{grid-column:span 1}}@media(max-width:520px){.cards,.grid2{grid-template-columns:1fr}.page-head{align-items:flex-start;gap:14px;flex-direction:column}}

.dashboard-cards{grid-template-columns:repeat(5,1fr)}.queue-cards{grid-template-columns:repeat(2,minmax(180px,260px))}.queue-actions{display:flex;justify-content:flex-end;margin-bottom:16px}.queue-actions form{display:flex;gap:8px}.queue-actions input{max-width:180px}.row-actions{display:flex;gap:6px;align-items:center;flex-wrap:wrap}.row-actions form{margin:0}.row-actions .btn{white-space:nowrap;font-size:12px;padding:8px 10px}.ticket{font-size:18px;color:#0f766e}.badge.priority{background:#fff4e5;color:#b54708}.danger{background:#fef3f2;color:#b42318}.card-link{display:inline-block;margin-top:8px;color:#0f766e;text-decoration:none;font-weight:700;font-size:13px}@media(max-width:1050px){.dashboard-cards{grid-template-columns:repeat(3,1fr)}}@media(max-width:800px){.dashboard-cards{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.dashboard-cards,.queue-cards{grid-template-columns:1fr}}

/* Classificação de risco */
.risk-summary{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:22px}.risk-card{background:#fff;border:1px solid #eaecf0;border-left:8px solid #98a2b3;border-radius:12px;padding:16px}.risk-card span{display:block;font-size:13px;color:#667085}.risk-card strong{font-size:28px;display:block;margin-top:6px}.risk-vermelho{border-left-color:#d92d20}.risk-laranja{border-left-color:#f79009}.risk-amarelo{border-left-color:#fdb022}.risk-verde{border-left-color:#12b76a}.risk-azul{border-left-color:#2e90fa}.risk-badge{display:inline-block;border-radius:999px;padding:5px 9px;font-size:12px;font-weight:800;border:1px solid transparent}.risk-badge.risk-vermelho{background:#fef3f2;color:#b42318;border-color:#fecdca}.risk-badge.risk-laranja{background:#fff4e5;color:#b54708;border-color:#fedf89}.risk-badge.risk-amarelo{background:#fefbe8;color:#854a0e;border-color:#fef0c7}.risk-badge.risk-verde{background:#ecfdf3;color:#067647;border-color:#abefc6}.risk-badge.risk-azul{background:#eff8ff;color:#175cd3;border-color:#b2ddff}.risk-checks{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:24px}.check{display:flex;flex-direction:row;align-items:center;background:#f9fafb;border:1px solid #eaecf0;border-radius:8px;padding:10px;margin:0}.check input{width:auto;margin:0 10px 0 0}.clinical-warning{border-left:5px solid #f79009}.muted{color:#98a2b3;font-size:12px}@media(max-width:900px){.risk-summary{grid-template-columns:repeat(3,1fr)}}@media(max-width:600px){.risk-summary,.risk-checks{grid-template-columns:1fr}}

.permission-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px;margin-top:12px}.permission-item{display:flex;gap:10px;align-items:flex-start;border:1px solid #d9e0e7;border-radius:10px;padding:12px;background:#fff}.permission-item input{width:auto;margin-top:4px}.permission-item span{display:flex;flex-direction:column;gap:3px}.permission-item code{font-size:.75rem}.permission-item small{color:#667085}.checkline{display:flex!important;align-items:center;gap:8px}.checkline input{width:auto}.field-error{display:block;color:#b42318}.alert{padding:12px 14px;border-radius:8px;margin:12px 0}.alert.success{background:#ecfdf3}.alert.error{background:#fef3f2;color:#b42318}.actions{display:flex;gap:10px;align-items:center}
