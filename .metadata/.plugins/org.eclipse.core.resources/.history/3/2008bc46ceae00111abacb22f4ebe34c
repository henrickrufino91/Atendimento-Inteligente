<!DOCTYPE html><html lang="pt-br" xmlns:th="http://www.thymeleaf.org"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Agendamentos</title><link rel="stylesheet" th:href="@{/css/app.css}"></head><body><nav th:replace="~{fragments :: nav}"></nav><main class="container"><div class="page-head"><div><h1>Agendamentos</h1><p>Agenda clínica</p></div><a class="primary btn" th:href="@{/agendamentos/novo}">Novo agendamento</a></div><div class="alert success" th:if="${sucesso}" th:text="${sucesso}"></div><section class="panel"><table><thead><tr><th>Data/Hora</th><th>Paciente</th><th>Profissional</th><th>Tipo</th><th>Prioridade</th><th>Status</th><th>Ações</th></tr></thead><tbody><tr th:each="a:${agendamentos}"><td th:text="${#temporals.format(a.dataHora,'dd/MM/yyyy HH:mm')}"></td><td th:text="${a.paciente.nome}"></td><td th:text="${a.profissional.nome}"></td><td th:text="${a.tipo}"></td><td><span class="badge" th:text="${a.prioridade}"></span></td><td th:text="${a.status}"></td><td><a th:href="@{/atendimentos/novo(agendamentoId=${a.id})}">Atender</a></td></tr></tbody></table></section></main></body></html>