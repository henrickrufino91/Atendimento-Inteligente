@media(max-width:1080px){.brand-copy small{display:none}.nav-home,.nav-group>summary,.linkbtn{padding:9px 8px;font-size:13px}}
@media(max-width:900px){.topbar{padding:0 18px}.nav-shell{flex-wrap:wrap;gap:0}.nav-toggle{display:block}.links{display:none;width:100%;flex-direction:column;align-items:stretch;gap:5px;padding:8px 0 14px}.links.open{display:flex}.nav-home,.nav-group>summary,.linkbtn{display:block;width:100%;padding:11px 12px;text-align:left}.nav-group{width:100%}.nav-dropdown,.nav-dropdown-right{position:static;width:100%;margin:4px 0 6px;border:0;border-left:2px solid #d0d5dd;border-radius:0;box-shadow:none;padding:3px 0 3px 8px}.nav-dropdown .nav-item{padding:9px 11px}.nav-divider{width:100%;height:1px;margin:5px 0;background:#eaecf0}.logout-form{width:100%}.brand-copy small{display:block}}

/* Impressão */
.print-only{display:none}
@media print{
 @page{size:A4;margin:12mm}
