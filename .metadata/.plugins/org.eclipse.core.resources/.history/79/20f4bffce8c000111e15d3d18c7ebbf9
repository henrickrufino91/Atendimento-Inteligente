.analytics-grid{align-items:stretch}.chart-panel{min-height:340px}.chart-title{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.chart-title p{margin:-6px 0 10px;color:#667085;font-size:13px}.report-canvas{width:100%;height:270px;display:block}.report-canvas.wide{height:310px}.legend{font-size:12px;color:#667085;white-space:nowrap}.dot{width:9px;height:9px;border-radius:50%;display:inline-block;margin:0 5px 0 10px}.dot-a{background:#d92d20}.dot-b{background:#f79009}.report-export{display:flex;align-items:center;justify-content:space-between;gap:14px}.pdf-form{display:flex;align-items:center;gap:8px}.pdf-form input{width:165px}.live-body{background:#eef3f8}.live-container{max-width:1440px}.live-cards{grid-template-columns:repeat(7,1fr)}.live-kpi{border-top:4px solid #0f766e}.live-kpi strong{font-size:27px}@media(max-width:1200px){.live-cards{grid-template-columns:repeat(4,1fr)}}@media(max-width:850px){.report-export{align-items:flex-start;flex-direction:column}.live-cards{grid-template-columns:repeat(2,1fr)}.analytics-grid{grid-template-columns:1fr}}@media(max-width:520px){.live-cards{grid-template-columns:1fr}.pdf-form{flex-wrap:wrap}.report-canvas{height:230px}}
/* Navegação principal organizada */
.topbar{height:auto;min-height:68px;padding:0 3%;z-index:1000;overflow:visible}.nav-shell{width:100%;display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:68px}.brand{display:flex;align-items:center;gap:10px;flex:0 0 auto}.brand-mark{width:36px;height:36px;border-radius:10px;display:grid;place-items:center;background:#0f766e;color:#fff;font-size:15px;font-weight:900}.brand-copy{display:flex;flex-direction:column;line-height:1.05}.brand-copy strong{font-size:16px}.brand-copy small{margin-top:4px;color:#667085;font-size:10px;font-weight:600}.links{gap:4px;justify-content:flex-end}.nav-home,.nav-group>summary,.linkbtn{padding:10px 11px;border-radius:8px;font-size:14px;font-weight:650;white-space:nowrap}.nav-home:hover,.nav-group>summary:hover,.linkbtn:hover{background:#f2f4f7;color:#0f766e}.nav-home.active{background:#ecfdf3;color:#067647}.nav-group{position:relative}.nav-group>summary{list-style:none;cursor:pointer;color:#344054;user-select:none}.nav-group>summary::-webkit-details-marker{display:none}.nav-group.active-group>summary{background:#ecfdf3;color:#067647}.chevron{font-size:13px;margin-left:4px;display:inline-block;transition:transform .18s}.nav-group[open]>summary .chevron{transform:rotate(180deg)}.nav-dropdown{position:absolute;top:calc(100% + 9px);left:0;width:300px;background:#fff;border:1px solid #eaecf0;border-radius:12px;box-shadow:0 16px 40px #1018281f;padding:8px;z-index:1200}.nav-dropdown-right{left:auto;right:0}.nav-section-title{padding:8px 10px 6px;text-transform:uppercase;letter-spacing:.06em;color:#98a2b3;font-size:10px;font-weight:800}.nav-dropdown .nav-item{display:flex;flex-direction:column;gap:3px;padding:10px 11px;border-radius:9px;color:#344054;text-decoration:none}.nav-dropdown .nav-item:hover{background:#f8fafc}.nav-dropdown .nav-item.active{background:#ecfdf3;color:#067647}.nav-dropdown .nav-item b{font-size:13px}.nav-dropdown .nav-item small{font-size:11px;color:#667085;font-weight:500}.nav-dropdown .nav-it