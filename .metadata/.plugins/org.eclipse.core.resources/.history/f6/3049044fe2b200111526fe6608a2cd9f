package br.com.hospital.atendimento.model;
import jakarta.persistence.*; import lombok.*; import java.util.*;
@Entity @Getter @Setter @NoArgsConstructor @Table(name="perfil")
public class Perfil {
 @Id @GeneratedValue(strategy=GenerationType.IDENTITY) private Long id;
 @Column(nullable=false,unique=true,length=80) private String nome;
 private String descricao; private boolean ativo=true; private boolean sistema=false;
 @ManyToMany(fetch=FetchType.EAGER)
 @JoinTable(name="perfil_permissao",joinColumns=@JoinColumn(name="perfil_id"),inverseJoinColumns=@JoinColumn(name="permissao_id"))
 private Set<Permissao> permissoes=new HashSet<>();
}
