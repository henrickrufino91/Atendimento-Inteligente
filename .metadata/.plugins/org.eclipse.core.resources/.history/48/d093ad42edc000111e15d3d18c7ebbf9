<!DOCTYPE html><html lang="pt-br" xmlns:th="http://www.thymeleaf.org"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Paciente</title><link rel="stylesheet" th:href="@{/css/app.css}"></head><body><nav th:replace="~{fragments :: nav}"></nav><main class="container narrow"><div class="page-head"><div><h1 th:text="${paciente.id==null?'Novo paciente':'Editar paciente'}"></h1></div></div><div class="alert error" th:if="${erro}" th:text="${erro}"></div><form class="panel form-grid" th:action="@{/pacientes/salvar}" th:object="${paciente}" method="post"><input type="hidden" th:field="*{id}"><label class="span2">Nome<input th:field="*{nome}" required></label><label>CPF<input th:field="*{cpf}" required></label><label>Data de nascimento<input type="date" th:field="*{dataNascimento}" required></label><label>Sexo<select th:field="*{sexo}"><option th:each="s:${sexos}" th:value="${s}" th:text="${s}"></option></select></label><label>Tipo sanguíneo<input th:field="*{tipoSanguineo}"></label><label>E-mail<input type="email" th:field="*{email}"></label><label>Telefone<input th:field="*{telefone}"></label><label class="span2">Endereço<input th:field="*{endereco}"></label><label class="span2">Alergias<textarea th:field="*{alergias}"></textarea></label><div class="span2 actions"><a class="btn secondary" th:href="@{/pacientes}">Cancelar</a><button class="primary">Salvar</button></div></form></main></body></html>