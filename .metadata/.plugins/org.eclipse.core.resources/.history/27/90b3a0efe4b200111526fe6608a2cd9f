<!doctype html><html lang="pt-BR" xmlns:th="http://www.thymeleaf.org"><head><meta charset="utf-8"><title>Perfis</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/app.css"></head><body><nav class="navbar navbar-dark bg-dark navbar-expand-xl mb-4"><div class="container-fluid"><a class="navbar-brand" href="/">Atendimento Inteligente v3</a><div class="navbar-nav flex-wrap"><a class="nav-link" href="/">Dashboard</a><a class="nav-link" href="/pacientes">Pacientes</a><a class="nav-link" href="/fila-senhas">Fila</a><a class="nav-link" href="/triagens">Triagem</a><a class="nav-link" href="/atendimentos">Atendimento</a><a class="nav-link" href="/relatorios">Relatórios</a><a class="nav-link" href="/usuarios">Usuários</a><a class="nav-link" href="/perfis">Perfis</a><form method="post" action="/logout"><button class="btn btn-sm btn-outline-light mt-1">Sair</button></form></div></div></nav><main class="container">
<div class="d-flex justify-content-between"><h2>Perfis e permissões</h2><a class="btn btn-primary" href="/perfis/novo">Novo perfil</a></div>
<table class="table table-striped"><thead><tr><th>Perfil</th><th>Descrição</th><th>Permissões</th><th></th></tr></thead><tbody><tr th:each="p:${itens}"><td th:text="${p.nome}"></td><td th:text="${p.descricao}"></td><td><span th:each="x:${p.permissoes}" class="badge bg-info text-dark me-1" th:text="${x.nome}"></span></td><td><a class="btn btn-sm btn-outline-primary" th:href="@{/perfis/{id}/editar(id=${p.id})}">Editar</a></td></tr></tbody></table>
</main></body></html>
