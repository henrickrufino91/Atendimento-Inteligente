<!doctype html><html lang="pt-BR" xmlns:th="http://www.thymeleaf.org"><head><meta charset="utf-8"><title>Auditoria</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/app.css"></head><body><nav class="navbar navbar-dark bg-dark navbar-expand-xl mb-4"><div class="container-fluid"><a class="navbar-brand" href="/">Atendimento Inteligente v4</a><div class="navbar-nav flex-wrap"><a class="nav-link" href="/">Dashboard</a><a class="nav-link" href="/pacientes">Pacientes</a><a class="nav-link" href="/fila-senhas">Fila</a><a class="nav-link" href="/triagens">Triagem</a><a class="nav-link" href="/atendimentos">Atendimento</a><a class="nav-link" href="/relatorios">Relatórios</a><a class="nav-link" href="/usuarios">Usuários</a><a class="nav-link" href="/perfis">Perfis</a><a class="nav-link" href="/auditoria">Auditoria</a><form method="post" action="/logout"><button class="btn btn-sm btn-outline-light mt-1">Sair</button></form></div></div></nav><main class="container">
<h2>Auditoria de segurança</h2><h4>Alterações administrativas</h4><table class="table table-sm table-striped"><thead><tr><th>Data</th><th>Responsável</th><th>Ação</th><th>Entidade</th><th>Detalhes</th></tr></thead><tbody><tr th:each="a:${auditorias}"><td th:text="${a.dataHora}"></td><td th:text="${a.usuarioResponsavel}"></td><td th:text="${a.acao}"></td><td th:text="${a.entidade}"></td><td th:text="${a.detalhes}"></td></tr></tbody></table>
<h4>Histórico de login</h4><table class="table table-sm"><thead><tr><th>Data</th><th>E-mail</th><th>Sucesso</th><th>Detalhe</th></tr></thead><tbody><tr th:each="l:${logins}"><td th:text="${l.dataHora}"></td><td th:text="${l.email}"></td><td th:text="${l.sucesso}"></td><td th:text="${l.detalhe}"></td></tr></tbody></table>
</main></body></html>
