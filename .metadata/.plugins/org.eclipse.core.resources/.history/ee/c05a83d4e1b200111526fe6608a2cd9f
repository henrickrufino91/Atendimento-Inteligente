<!doctype html><html lang="pt-BR" xmlns:th="http://www.thymeleaf.org" xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Fila de Senhas</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/app.css"></head>
<body>
<nav class="navbar navbar-dark bg-dark navbar-expand-lg mb-4"><div class="container-fluid">
<a class="navbar-brand" href="/">Atendimento Inteligente</a><div class="navbar-nav flex-wrap">
<a class="nav-link" href="/">Dashboard</a><a class="nav-link" href="/pacientes">Pacientes</a>
<a class="nav-link" href="/profissionais">Profissionais</a><a class="nav-link" href="/agendamentos">Agendamentos</a>
<a class="nav-link" href="/fila-senhas">Fila de Senhas</a><a class="nav-link" href="/atendimentos">Atendimentos</a>
<a class="nav-link" href="/prescricoes">Prescrições</a><a class="nav-link" href="/exames">Exames</a>
<a class="nav-link" sec:authorize="hasAnyRole('ADMIN','GESTOR')" href="/relatorios">Relatórios</a>
<form class="d-inline" method="post" action="/logout"><button class="btn btn-outline-light btn-sm mt-1">Sair</button></form>
</div></div></nav>
<main class="container">
<h2>Fila de Senhas</h2><form class="row g-2 mb-4" method="post" action="/fila-senhas/emitir">
<div class="col-md-3"><select class="form-select" name="prioridade"><option th:each="p:${prioridades}" th:value="${p}" th:text="${p}"></option></select></div>
<div class="col-md-5"><select class="form-select" name="pacienteId"><option value="">Paciente opcional</option><option th:each="p:${pacientes}" th:value="${p.id}" th:text="${p.nome}"></option></select></div>
<div class="col"><button class="btn btn-primary">Emitir senha</button></div></form>
<table class="table align-middle"><thead><tr><th>Senha</th><th>Prioridade</th><th>Paciente</th><th>Status</th><th>Guichê</th><th>Ações</th></tr></thead><tbody>
<tr th:each="s:${senhas}"><td class="fs-4 fw-bold" th:text="${s.codigo}"></td><td th:text="${s.prioridade}"></td><td th:text="${s.paciente!=null?s.paciente.nome:'—'}"></td><td th:text="${s.status}"></td><td th:text="${s.guiche}"></td><td class="d-flex gap-1">
<form th:action="@{/fila-senhas/{id}/chamar(id=${s.id})}" method="post"><input name="guiche" value="01" size="2"><button class="btn btn-sm btn-warning">Chamar</button></form>
<form th:action="@{/fila-senhas/{id}/iniciar(id=${s.id})}" method="post"><button class="btn btn-sm btn-info">Iniciar</button></form>
<form th:action="@{/fila-senhas/{id}/finalizar(id=${s.id})}" method="post"><button class="btn btn-sm btn-success">Finalizar</button></form>
</td></tr></tbody></table>
</main></body></html>