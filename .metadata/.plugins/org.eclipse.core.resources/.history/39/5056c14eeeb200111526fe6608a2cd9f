package br.com.portal.projeto.controller;

import java.time.LocalDateTime;

import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.servlet.mvc.support.RedirectAttributes;

import br.com.portal.projeto.entity.Atendimento;
import br.com.portal.projeto.entity.Exame;
import br.com.portal.projeto.entity.NivelRisco;
import br.com.portal.projeto.entity.Prescricao;
import br.com.portal.projeto.entity.Prioridade;
import br.com.portal.projeto.repository.AgendamentoRepository;
import br.com.portal.projeto.repository.AtendimentoRepository;
import br.com.portal.projeto.repository.ExameRepository;
import br.com.portal.projeto.repository.PacienteRepository;
import br.com.portal.projeto.repository.PrescricaoRepository;
import br.com.portal.projeto.repository.ProfissionalRepository;
import br.com.portal.projeto.service.InteligenciaService;
import lombok.RequiredArgsConstructor;

@Controller
@RequestMapping("/atendimentos")
@RequiredArgsConstructor
public class AtendimentoController {
	private final AtendimentoRepository atendimentos;
	private final PacienteRepository pacientes;
	private final ProfissionalRepository profissionais;
	private final AgendamentoRepository agendamentos;
	private final PrescricaoRepository prescricoes;
	private final ExameRepository exames;
	private final InteligenciaService inteligencia;
	private final br.com.portal.projeto.service.FilaSenhaService filaSenhaService;
	private final br.com.hospital.service.ClassificacaoRiscoService classificacaoRiscoService;

	@GetMapping
	String listar(Model m) {
		m.addAttribute("atendimentos", atendimentos.findTop10ByOrderByInicioDesc());
		return "atendimentos/lista";
	}

	@GetMapping("/novo")
	String novo(@RequestParam(required = false) Long agendamentoId, @RequestParam(required = false) Long senhaId,
			@RequestParam(required = false) Long pacienteId, Model m) {
		m.addAttribute("pacientes", pacientes.findAll());
		m.addAttribute("profissionais", profissionais.findByAtivoTrueOrderByNome());
		m.addAttribute("agendamentoId", agendamentoId);
		m.addAttribute("senhaId", senhaId);
		m.addAttribute("pacienteId", pacienteId);
		m.addAttribute("prioridades", Prioridade.values());
		return "atendimentos/form";
	}

	@PostMapping("/salvar")
	String salvar(@RequestParam Long pacienteId, @RequestParam Long profissionalId,
			@RequestParam(required = false) Long agendamentoId, @RequestParam(required = false) Long senhaId,
			@RequestParam String queixaPrincipal, @RequestParam(required = false) String anamnese,
			@RequestParam(required = false) String pressaoArterial, @RequestParam(required = false) Double temperatura,
			@RequestParam(required = false) Integer frequenciaCardiaca,
			@RequestParam(required = false) Double saturacao, RedirectAttributes ra) {
		var triagem = inteligencia.analisar(queixaPrincipal, temperatura, frequenciaCardiaca, saturacao);
		var prioridade = senhaId == null ? triagem.prioridade()
				: classificacaoRiscoService.buscarPorSenha(senhaId).map(c -> mapearPrioridade(c.getNivelFinal()))
						.orElse(triagem.prioridade());
		var a = Atendimento.builder().paciente(pacientes.findById(pacienteId).orElseThrow())
				.profissional(profissionais.findById(profissionalId).orElseThrow())
				.agendamento(agendamentoId == null ? null : agendamentos.findById(agendamentoId).orElse(null))
				.inicio(LocalDateTime.now()).queixaPrincipal(queixaPrincipal).anamnese(anamnese)
				.pressaoArterial(pressaoArterial).temperatura(temperatura).frequenciaCardiaca(frequenciaCardiaca)
				.saturacao(saturacao).classificacao(prioridade).build();
		a = atendimentos.save(a);
		if (senhaId != null)
			filaSenhaService.vincularAtendimento(senhaId, a);
		ra.addFlashAttribute("sucesso", "Atendimento aberto com prioridade " + prioridade + ".");
		return "redirect:/atendimentos/" + a.getId();
	}

	@GetMapping("/{id}")
	String detalhe(@PathVariable Long id, Model m) {
		var a = atendimentos.findById(id).orElseThrow();
		m.addAttribute("atendimento", a);
		m.addAttribute("prescricoes", prescricoes.findByAtendimentoIdOrderByCriadoEmDesc(id));
		m.addAttribute("exames", exames.findByAtendimentoIdOrderByIdDesc(id));
		m.addAttribute("triagem", inteligencia.analisar(a.getQueixaPrincipal(), a.getTemperatura(),
				a.getFrequenciaCardiaca(), a.getSaturacao()));
		return "atendimentos/detalhe";
	}

	@PostMapping("/{id}/finalizar")
	String finalizar(@PathVariable Long id, @RequestParam String diagnostico, @RequestParam String conduta) {
		var a = atendimentos.findById(id).orElseThrow();
		a.setDiagnostico(diagnostico);
		a.setConduta(conduta);
		a.setFim(LocalDateTime.now());
		atendimentos.save(a);
		filaSenhaService.finalizarPorAtendimento(id);
		return "redirect:/atendimentos/" + id;
	}

	@PostMapping("/{id}/prescricoes")
	String prescrever(@PathVariable Long id, @RequestParam String medicamento, @RequestParam String dosagem,
			@RequestParam String frequencia, @RequestParam(required = false) String duracao,
			@RequestParam(required = false) String orientacoes) {
		prescricoes
				.save(Prescricao.builder().atendimento(atendimentos.findById(id).orElseThrow()).medicamento(medicamento)
						.dosagem(dosagem).frequencia(frequencia).duracao(duracao).orientacoes(orientacoes).build());
		return "redirect:/atendimentos/" + id;
	}

	@PostMapping("/{id}/exames")
	String exame(@PathVariable Long id, @RequestParam String nome, @RequestParam(required = false) String observacoes) {
		exames.save(Exame.builder().atendimento(atendimentos.findById(id).orElseThrow()).nome(nome).status("SOLICITADO")
				.observacoes(observacoes).build());
		return "redirect:/atendimentos/" + id;
	}

	private Prioridade mapearPrioridade(NivelRisco nivel) {
		return switch (nivel) {
		case VERMELHO -> Prioridade.EMERGENCIA;
		case LARANJA -> Prioridade.URGENTE;
		case AMARELO -> Prioridade.ALTA;
		case VERDE -> Prioridade.NORMAL;
		case AZUL -> Prioridade.BAIXA;
		};
	}

}
