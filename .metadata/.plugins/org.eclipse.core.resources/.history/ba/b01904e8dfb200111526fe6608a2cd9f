package br.com.hospital.atendimento.controller;
import br.com.hospital.atendimento.model.*; import br.com.hospital.atendimento.repository.*;
import org.springframework.stereotype.Controller; import org.springframework.ui.Model; import org.springframework.web.bind.annotation.*;
@Controller @RequestMapping("/agendamentos")
public class AgendamentoController {
 private final AgendamentoRepository repo; private final PacienteRepository pacientes; private final ProfissionalRepository profissionais;
 public AgendamentoController(AgendamentoRepository r,PacienteRepository p,ProfissionalRepository pr){repo=r;pacientes=p;profissionais=pr;}
 @GetMapping public String lista(Model m){m.addAttribute("itens",repo.findAll());return "agendamentos/lista";}
 @GetMapping("/novo") public String novo(Model m){m.addAttribute("item",new Agendamento());m.addAttribute("pacientes",pacientes.findAll());m.addAttribute("profissionais",profissionais.findAll());return "agendamentos/form";}
 @PostMapping("/salvar") public String salvar(@ModelAttribute Agendamento x){repo.save(x);return "redirect:/agendamentos";}
 @PostMapping("/{id}/excluir") public String excluir(@PathVariable Long id){repo.deleteById(id);return "redirect:/agendamentos";}
}
