package br.com.hospital.controller;

import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.servlet.mvc.support.RedirectAttributes;

import br.com.portal.projeto.entity.NivelRisco;
import br.com.portal.projeto.repository.SenhaAtendimentoRepository;
import br.com.portal.projeto.service.ClassificacaoRiscoService;
import lombok.RequiredArgsConstructor;

@Controller
@RequestMapping("/classificacao-risco")
@RequiredArgsConstructor
public class ClassificacaoRiscoController {
	private final ClassificacaoRiscoService service;
	private final SenhaAtendimentoRepository senhas;

	@GetMapping
	String lista(Model model) {
		model.addAttribute("classificacoes", service.ultimas());
		for (NivelRisco n : NivelRisco.values()) {
			model.addAttribute("qtd" + n.name(), service.quantidadeHoje(n));
		}
		return "classificacao/lista";
	}

	@GetMapping("/senha/{senhaId}")
	String formulario(@PathVariable Long senhaId, Model model) {
		var senha = senhas.findById(senhaId).orElseThrow();
		model.addAttribute("senha", senha);
		model.addAttribute("classificacao", service.buscarPorSenha(senhaId).orElse(null));
		model.addAttribute("niveis", NivelRisco.values());
		return "classificacao/form";
	}

	@PostMapping("/senha/{senhaId}")
	String salvar(@PathVariable Long senhaId, @RequestParam String queixaPrincipal,
			@RequestParam(required = false) String pressaoArterial, @RequestParam(required = false) Double temperatura,
			@RequestParam(required = false) Integer frequenciaCardiaca,
			@RequestParam(required = false) Integer frequenciaRespiratoria,
			@RequestParam(required = false) Double saturacao, @RequestParam(required = false) Integer escalaDor,
			@RequestParam(defaultValue = "false") Boolean consciente,
			@RequestParam(defaultValue = "false") Boolean dificuldadeRespiratoria,
			@RequestParam(defaultValue = "false") Boolean sangramentoImportante,
			@RequestParam(defaultValue = "false") Boolean dorToracica,
			@RequestParam(defaultValue = "false") Boolean deficitNeurologicoAgudo,
			@RequestParam(required = false) NivelRisco nivelFinal, @RequestParam(required = false) String profissional,
			@RequestParam(required = false) String justificativaAlteracao,
			@RequestParam(required = false) String observacoes, RedirectAttributes ra) {
		try {
			var c = service.salvar(senhaId, queixaPrincipal, pressaoArterial, temperatura, frequenciaCardiaca,
					frequenciaRespiratoria, saturacao, escalaDor, consciente, dificuldadeRespiratoria,
					sangramentoImportante, dorToracica, deficitNeurologicoAgudo, nivelFinal, profissional,
					justificativaAlteracao, observacoes);
			ra.addFlashAttribute("sucesso",
					"Classificação salva: " + c.getNivelFinal() + " — " + c.getNivelFinal().getDescricao());
			return "redirect:/fila-senhas";
		} catch (IllegalArgumentException e) {
			ra.addFlashAttribute("erro", e.getMessage());
			return "redirect:/classificacao-risco/senha/" + senhaId;
		}
	}
}
