package br.com.portal.projeto.controller;

import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;

import br.com.portal.projeto.entity.Prescricao;
import br.com.portal.projeto.repository.PacienteRepository;
import br.com.portal.projeto.repository.PrescricaoRepository;
import br.com.portal.projeto.repository.ProfissionalRepository;

@Controller
@RequestMapping("/prescricoes")
public class PrescricaoController {
	private final PrescricaoRepository repo;
	private final PacienteRepository pacientes;
	private final ProfissionalRepository profissionais;

	public PrescricaoController(PrescricaoRepository r, PacienteRepository p, ProfissionalRepository pr) {
		repo = r;
		pacientes = p;
		profissionais = pr;
	}

	@GetMapping
	public String lista(Model m) {
		m.addAttribute("itens", repo.findAll());
		return "prescricoes/lista";
	}

	@GetMapping("/novo")
	public String novo(Model m) {
		m.addAttribute("item", new Prescricao());
		m.addAttribute("pacientes", pacientes.findAll());
		m.addAttribute("profissionais", profissionais.findAll());
		return "prescricoes/form";
	}

	@PostMapping("/salvar")
	public String salvar(@ModelAttribute Prescricao x) {
		repo.save(x);
		return "redirect:/prescricoes";
	}

	@PostMapping("/{id}/excluir")
	public String excluir(@PathVariable Long id) {
		repo.deleteById(id);
		return "redirect:/prescricoes";
	}
}
