<!doctype html><html lang="pt-BR" xmlns:th="http://www.thymeleaf.org"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Novo atendimento</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/app.css"></head><body><nav class="navbar navbar-dark bg-dark navbar-expand-xl mb-4"><div class="container-fluid"><a class="navbar-brand" href="/">Atendimento Inteligente v2</a><div class="navbar-nav flex-wrap"><a class="nav-link" href="/">Dashboard</a><a class="nav-link" href="/pacientes">Pacientes</a><a class="nav-link" href="/profissionais">Profissionais</a><a class="nav-link" href="/agendamentos">Agendamentos</a><a class="nav-link" href="/fila-senhas">Fila</a><a class="nav-link" href="/triagens">Triagem</a><a class="nav-link" href="/atendimentos">Atendimento</a><a class="nav-link" href="/prescricoes">Prescrições</a><a class="nav-link" href="/exames">Exames</a><a class="nav-link" href="/relatorios">Relatórios</a><form method="post" action="/logout"><button class="btn btn-sm btn-outline-light mt-1">Sair</button></form></div></div></nav><main class="container">
<h2>Novo atendimento</h2><form method="post" action="/atendimentos/salvar">
<label>Paciente</label><select class="form-select mb-2" name="paciente.id" required><option th:each="p:${pacientes}" th:value="${p.id}" th:text="${p.nome}"></option></select>
<label>Profissional</label><select class="form-select mb-2" name="profissional.id"><option th:each="p:${profissionais}" th:value="${p.id}" th:text="${p.nome}"></option></select>
<label>Queixa</label><textarea class="form-control mb-2" name="queixa"></textarea><label>Avaliação/conduta</label><textarea class="form-control mb-3" name="conduta"></textarea><button class="btn btn-success">Abrir atendimento</button></form>
</main></body></html>
