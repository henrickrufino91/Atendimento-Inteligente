package br.com.portal.projeto.entity;

import java.time.LocalDateTime;

import br.com.portal.projeto.entity.enums.NivelRisco;
import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.EnumType;
import jakarta.persistence.Enumerated;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import jakarta.persistence.JoinColumn;
import jakarta.persistence.ManyToOne;
import jakarta.persistence.OneToOne;
import jakarta.persistence.PrePersist;
import jakarta.persistence.Table;
import lombok.AllArgsConstructor;
import lombok.Builder;
import lombok.Getter;
import lombok.NoArgsConstructor;
import lombok.Setter;

@Entity
@Table(name = "classificacao_risco")
@Getter
@Setter
@NoArgsConstructor
@AllArgsConstructor
@Builder
public class ClassificacaoRisco {
	
	@Id
	@GeneratedValue(strategy = GenerationType.IDENTITY)
	private Long id;

	@OneToOne(optional = false)
	@JoinColumn(name = "senha_id", nullable = false, unique = true)
	private SenhaAtendimento senha;

	@ManyToOne
	@JoinColumn(name = "paciente_id")
	private Paciente paciente;

	@Column(nullable = false, length = 1000)
	private String queixaPrincipal;

	@Column(length = 20)
	private String pressaoArterial;
	private Double temperatura;
	private Integer frequenciaCardiaca;
	private Integer frequenciaRespiratoria;
	private Double saturacao;
	private Integer escalaDor;

	@Builder.Default
	@Column(nullable = false)
	private Boolean consciente = true;

	@Builder.Default
	@Column(nullable = false)
	private Boolean dificuldadeRespiratoria = false;

	@Builder.Default
	@Column(nullable = false)
	private Boolean sangramentoImportante = false;

	@Builder.Default
	@Column(nullable = false)
	private Boolean dorToracica = false;

	@Builder.Default
	@Column(nullable = false)
	private Boolean deficitNeurologicoAgudo = false;

	@Enumerated(EnumType.STRING)
	@Column(name = "nivel_sugerido", nullable = false, length = 20)
	private NivelRisco nivelSugerido;

	@Enumerated(EnumType.STRING)
	@Column(name = "nivel_final", nullable = false, length = 20)
	private NivelRisco nivelFinal;

	@Column(length = 150)
	private String profissional;

	@Column(length = 1000)
	private String justificativaAlteracao;

	@Column(length = 1500)
	private String observacoes;

	@Column(name = "classificado_em", nullable = false)
	private LocalDateTime classificadoEm;

	@PrePersist
	void prePersist() {
		if (classificadoEm == null)
			classificadoEm = LocalDateTime.now();
	}
}
