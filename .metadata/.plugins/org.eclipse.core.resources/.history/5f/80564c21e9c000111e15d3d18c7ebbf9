<!DOCTYPE html><html lang="pt-br" xmlns:th="http://www.thymeleaf.org"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Painel gerencial em tempo real</title><link rel="stylesheet" th:href="@{/css/app.css}"></head><body class="live-body">
<nav th:replace="~{fragments :: nav}"></nav><main class="container live-container"><div class="page-head"><div><h1>Painel gerencial em tempo real</h1><p>Atualização automática a cada 5 segundos · última atualização: <strong id="atualizadoEm">--:--:--</strong> <span id="statusLive"></span></p></div><div class="no-print"><button type="button" class="btn secondary" data-print>Imprimir painel</button> <a class="btn secondary" th:href="@{/relatorios}">Relatórios históricos</a></div></div>
<section class="cards live-cards"><div class="card live-kpi"><span>Aguardando</span><strong data-kpi="aguardando">0</strong></div><div class="card live-kpi"><span>Chamadas</span><strong data-kpi="chamadas">0</strong></div><div class="card live-kpi"><span>Em atendimento</span><strong data-kpi="emAtendimento">0</strong></div><div class="card live-kpi"><span>Finalizadas hoje</span><strong data-kpi="finalizadasHoje">0</strong></div><div class="card live-kpi"><span>Atendimentos abertos</span><strong data-kpi="atendimentosAbertos">0</strong></div><div class="card live-kpi"><span>Espera média</span><strong data-kpi="esperaMediaMin">0 min</strong></div><div class="card live-kpi"><span>SLA risco hoje</span><strong data-kpi="slaRiscoHoje">0%</strong></div></section>
<section class="grid2 analytics-grid"><div class="panel chart-panel"><h2>Classificações de risco de hoje</h2><canvas id="liveRisco" class="report-canvas"></canvas></div><div class="panel chart-panel"><h2>Atendimentos por profissional hoje</h2><canvas id="liveProfissionais" class="report-canvas"></canvas></div></section>
<section class="panel"><h2>SLA por nível de risco</h2><table id="liveTable" class="compact"><thead><tr><th>Nível</th><th>Quantidade</th><th>Dentro do alvo</th></tr></thead><tbody></tbody></table></section>
</main><script th:src="@{/js/report-charts.js}"></script><script th:src="@{/js/painel-tempo-real.js}"></script><script th:src="@{/js/impressao.js}"></script></body></html>
