package br.com.hospital.atendimento.controller;
import br.com.hospital.atendimento.model.*; import br.com.hospital.atendimento.repository.*;
import org.springframework.stereotype.Controller; import org.springframework.ui.Model; import org.springframework.web.bind.annotation.*;
@Controller @RequestMapping("/prescricoes")
public class PrescricaoController {
 private final PrescricaoRepository repo; private final PacienteRepository pacientes; private final ProfissionalRepository profissionais;
 public PrescricaoController(PrescricaoRepository r,PacienteRepository p,ProfissionalRepository pr){repo=r;pacientes=p;profissionais=pr;}
 @GetMapping public String lista(Model m){m.addAttribute("itens",repo.findAll());return "prescricoes/lista";}
 @GetMapping("/novo") public String novo(Model m){m.addAttribute("item",new Prescricao());m.addAttribute("pacientes",pacientes.findAll());m.addAttribute("profissionais",profissionais.findAll());return "prescricoes/form";}
 @PostMapping("/salvar") public String salvar(@ModelAttribute Prescricao x){repo.save(x);return "redirect:/prescricoes";}
 @PostMapping("/{id}/excluir") public String excluir(@PathVariable Long id){repo.deleteById(id);return "redirect:/prescricoes";}
}
