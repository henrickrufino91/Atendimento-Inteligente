package br.com.portal.projeto.entity.enums;

public enum NivelRisco {
	VERMELHO(5, "Emergência", 0), LARANJA(4, "Muito urgente", 10), AMARELO(3, "Urgente", 60),
	VERDE(2, "Pouco urgente", 120), AZUL(1, "Não urgente", 240);

	private final int peso;
	private final String descricao;
	private final int tempoAlvoMinutos;

	NivelRisco(int peso, String descricao, int tempoAlvoMinutos) {
		this.peso = peso;
		this.descricao = descricao;
		this.tempoAlvoMinutos = tempoAlvoMinutos;
	}

	public int getPeso() {
		return peso;
	}

	public String getDescricao() {
		return descricao;
	}

	public int getTempoAlvoMinutos() {
		return tempoAlvoMinutos;
	}
}
