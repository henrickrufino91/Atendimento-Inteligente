<!doctype html><html lang="pt-BR" xmlns:th="http://www.thymeleaf.org"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Atendimento</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/app.css"></head><body><nav class="navbar navbar-dark bg-dark navbar-expand-xl mb-4"><div class="container-fluid"><a class="navbar-brand" href="/">Atendimento Inteligente v2</a><div class="navbar-nav flex-wrap"><a class="nav-link" href="/">Dashboard</a><a class="nav-link" href="/pacientes">Pacientes</a><a class="nav-link" href="/profissionais">Profissionais</a><a class="nav-link" href="/agendamentos">Agendamentos</a><a class="nav-link" href="/fila-senhas">Fila</a><a class="nav-link" href="/triagens">Triagem</a><a class="nav-link" href="/atendimentos">Atendimento</a><a class="nav-link" href="/prescricoes">Prescrições</a><a class="nav-link" href="/exames">Exames</a><a class="nav-link" href="/relatorios">Relatórios</a><form method="post" action="/logout"><button class="btn btn-sm btn-outline-light mt-1">Sair</button></form></div></div></nav><main class="container">
<h2>Atendimento</h2><div class="card p-3 mb-3"><h4 th:text="${item.paciente.nome}"></h4><p><b>Queixa:</b> <span th:text="${item.queixa}"></span></p><p><b>Conduta:</b> <span th:text="${item.conduta}"></span></p></div>
<div class="alert alert-warning" th:if="${!triagens.isEmpty()}"><b>Triagem disponível:</b> consulte os sinais vitais e registros recentes antes da conduta.</div>
<h4>Evolução clínica</h4><div th:each="e:${evolucoes}" class="card p-2 mb-2"><small th:text="${e.registradaEm}"></small><span th:text="${e.descricao}"></span></div>
<form method="post" th:action="@{/atendimentos/{id}/evolucao(id=${item.id})}"><textarea class="form-control mb-2" name="descricao" placeholder="Registrar evolução..." required></textarea><button class="btn btn-primary">Adicionar evolução</button></form>
<hr><h4>Encaminhamento</h4><form method="post" th:action="@{/atendimentos/{id}/encaminhamento(id=${item.id})}"><input class="form-control mb-2" name="destino" placeholder="Destino" required><textarea class="form-control mb-2" name="motivo" placeholder="Motivo"></textarea><button class="btn btn-outline-primary">Registrar encaminhamento</button></form>
<hr><form method="post" th:action="@{/atendimentos/{id}/finalizar(id=${item.id})}"><button class="btn btn-success">Finalizar atendimento</button></form>
</main></body></html>
