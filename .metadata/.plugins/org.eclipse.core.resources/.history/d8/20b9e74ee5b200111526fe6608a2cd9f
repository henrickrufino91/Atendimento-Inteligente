package br.com.hospital.atendimento.model;
import jakarta.persistence.*; import lombok.*;
@Entity @Getter @Setter @NoArgsConstructor @Table(name="permissao")
public class Permissao {
 @Id @GeneratedValue(strategy=GenerationType.IDENTITY) private Long id;
 @Column(nullable=false,unique=true,length=100) private String nome;
 private String descricao;
 public Permissao(String nome,String descricao){this.nome=nome;this.descricao=descricao;}
}
